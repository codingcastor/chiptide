{
  "name": "chiptide",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @chiptide/web dev",
    "build": "pnpm --filter @chiptide/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "render": "vite-node --config vitest.config.ts packages/engine/scripts/render.ts --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "docs": "vite-node --config vitest.config.ts packages/engine/scripts/docs.ts && prettier --write docs/reference.md"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-node": "^3.0.4",
    "vitest": "^3.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@codemirror/view": "6.43.13",
      "@codemirror/state": "6.7.6",
      "@codemirror/language": "6.12.4",
      "@codemirror/autocomplete": "6.20.3",
      "@codemirror/commands": "6.11.1",
      "@codemirror/search": "6.7.2",
      "@lezer/highlight": "1.2.5"
    }
  }
}
